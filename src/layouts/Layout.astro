---
import { ClientRouter } from "astro:transitions";
import "bulma/css/bulma.min.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

export interface Props {
    title: string;
    description?: string;
    currentPage?: string;
    image?: string;
    type?: "website" | "article";
    schema?: Record<string, any>;
}

const {
    title,
    description,
    currentPage,
    image = "/og-image.svg",
    type = "website",
    schema,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://xiaohuojian.homes");
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);

const defaultDescription =
    "小火箭 (xiaohuojian.homes) — 全球网络基础设施与42家精选机场评测智库。专注IEPL/IPLC内网专线、晚高峰带宽实测、流媒体与ChatGPT/Claude原生解锁测评。";
const metaDescription = description ?? defaultDescription;
const pageTitle = currentPage === "home" ? "小火箭 — 42家机场品牌测评智库与节点实测实验室" : `${title} — 小火箭`;

// Base JSON-LD schemas for search engines
const baseSchemas = [
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "小火箭网络评测智库",
        "url": siteUrl.href,
        "logo": new URL("/favicon.svg", siteUrl).href,
        "description": defaultDescription,
        "sameAs": []
    },
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "小火箭",
        "url": siteUrl.href,
        "potentialAction": {
            "@type": "SearchAction",
            "target": `${siteUrl.href}airports?q={search_term_string}`,
            "query-input": "required name=search_term_string"
        }
    }
];

if (schema) {
    baseSchemas.push(schema);
}
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <meta name="description" content={metaDescription} />
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

        <!-- Search Engine Site Verification Slots -->
        {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
            <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
        )}
        {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
            <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
        )}
        {import.meta.env.PUBLIC_SHENMA_SITE_VERIFICATION && (
            <meta name="shenma-site-verification" content={import.meta.env.PUBLIC_SHENMA_SITE_VERIFICATION} />
        )}
        {import.meta.env.PUBLIC_BAIDU_SITE_VERIFICATION && (
            <meta name="baidu-site-verification" content={import.meta.env.PUBLIC_BAIDU_SITE_VERIFICATION} />
        )}

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalURL} />

        <!-- Independent Native Favicon & Web Manifest -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#0C0E14" />

        <!-- RSS Feed Discovery -->
        <link rel="alternate" type="application/rss+xml" title="小火箭评测智库 RSS" href="/rss.xml" />

        <!-- Open Graph / Social Media -->
        <meta property="og:site_name" content="小火箭" />
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:locale" content="zh_CN" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={ogImageURL} />

        <!-- Structured Data (JSON-LD) -->
        {baseSchemas.map((s) => (
            <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
        ))}

        <script is:inline>
            const stored = localStorage.getItem("theme");
            const prefersDark = window.matchMedia(
                "(prefers-color-scheme: dark)",
            ).matches;
            if (stored === "dark" || (!stored && prefersDark)) {
                document.documentElement.setAttribute("data-theme", "dark");
            }
        </script>
        <ClientRouter />
    </head>
    <body>
        <a class="skip-link" href="#main-content">跳转至正文内容</a>

        <Navbar currentPage={currentPage} />

        <main id="main-content">
            <slot />
        </main>

        <Footer />
    </body>
</html>
