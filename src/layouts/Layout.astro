---
import { ClientRouter } from "astro:transitions";
import "bulma/css/bulma.min.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

export interface Props {
    title: string;
    description?: string;
    currentPage?: string;
    image?: string;
    type?: "website" | "article";
    schema?: Record<string, any>;
}

const {
    title,
    description,
    currentPage,
    image = "/og-image.svg",
    type = "website",
    schema,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://xiaohuojian.homes");
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);

const defaultDescription =
    "Studio Pulse — Full-service communication agency. Brand strategy, creative direction, digital craft, and content.";
const metaDescription = description ?? defaultDescription;
const pageTitle = currentPage === "home" ? "Studio Pulse — Brand Strategy, Creative Direction & Digital Craft" : `${title} — Studio Pulse`;

// Base JSON-LD schemas for search engines
const baseSchemas = [
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Studio Pulse",
        "url": siteUrl.href,
        "logo": new URL("/favicon.svg", siteUrl).href,
        "description": defaultDescription,
        "sameAs": []
    },
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Studio Pulse",
        "url": siteUrl.href,
        "potentialAction": {
            "@type": "SearchAction",
            "target": `${siteUrl.href}blog?q={search_term_string}`,
            "query-input": "required name=search_term_string"
        }
    }
];

if (schema) {
    baseSchemas.push(schema);
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <meta name="description" content={metaDescription} />
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalURL} />

        <!-- Independent Native Favicon & Web Manifest (100% self-hosted) -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#0C0E14" />

        <!-- RSS Feed Discovery -->
        <link rel="alternate" type="application/rss+xml" title="Studio Pulse Journal RSS" href="/rss.xml" />

        <!-- Open Graph / Facebook -->
        <meta property="og:site_name" content="Studio Pulse" />
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={ogImageURL} />

        <!-- Structured Data (JSON-LD) for Search Engines -->
        {baseSchemas.map((s) => (
            <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
        ))}

        <script is:inline>
            const stored = localStorage.getItem("theme");
            const prefersDark = window.matchMedia(
                "(prefers-color-scheme: dark)",
            ).matches;
            if (stored === "dark" || (!stored && prefersDark)) {
                document.documentElement.setAttribute("data-theme", "dark");
            }
        </script>
        <ClientRouter />
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to main content</a>

        <Navbar currentPage={currentPage} />

        <main id="main-content">
            <slot />
        </main>

        <Footer />
    </body>
</html>
