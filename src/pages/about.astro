---
import Layout from "../layouts/Layout.astro";
import {
    methodologyQuickCards,
    benchmarkMetricRows,
    auditTierRows,
    methodologyChapters,
    selfTestPlaybooks,
    aboutDecisionBranches,
    aboutConversionCards,
    aboutFaqs,
} from "../data/about";

const siteUrl = Astro.site ?? new URL("https://xiaohuojian.homes");
const pageUrl = new URL("/about", siteUrl).href;

const pageTitle = "小火箭评测实验室准则 (E-E-A-T)：7大评测指标、双轨价格审计与本地复现方法论";
const pageDescription =
    "了解小火箭 (xiaohuojian.homes) 评测实验室的工程级方法论：三大评测红线、MAI-TEST-BOT 与五地专线 RTT 量化评级阈值、42家机场四级证据分类、本地终端 curl/nslookup 验真指南及透明推广佣金声明。";

const pageSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "AboutPage",
            "@id": `${pageUrl}#aboutpage`,
            "name": pageTitle,
            "description": pageDescription,
            "url": pageUrl,
            "inLanguage": "zh-CN",
            "datePublished": "2026-08-11",
            "dateModified": "2026-11-07",
            "mainEntity": {
                "@type": "Organization",
                "@id": `${siteUrl.href}#organization`,
                "name": "小火箭网络基础设施评测智库 (xiaohuojian.homes)",
                "url": siteUrl.href,
                "logo": new URL("/favicon.svg", siteUrl).href,
                "publishingPrinciples": `${pageUrl}#chapter-redlines`,
                "correctionsPolicy": `${pageUrl}#data-sources-gaps`,
                "ethicsPolicy": `${pageUrl}#chapter-affiliate-ethics`
            }
        },
        {
            "@type": "TechArticle",
            "@id": `${pageUrl}#article`,
            "headline": pageTitle,
            "description": pageDescription,
            "url": pageUrl,
            "datePublished": "2026-08-11",
            "dateModified": "2026-11-07",
            "inLanguage": "zh-CN",
            "proficiencyLevel": "Beginner to Expert",
            "author": {
                "@type": "Organization",
                "name": "小火箭评测实验室 (MAI-TEST-BOT 工程组)",
                "url": siteUrl.href
            }
        },
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "首页",
                    "item": siteUrl.href
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": "评测方法论与透明声明 (METHODOLOGY & EEAT)",
                    "item": pageUrl
                }
            ]
        },
        {
            "@type": "FAQPage",
            "mainEntity": aboutFaqs.map((faq) => ({
                "@type": "Question",
                "name": faq.question,
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": `${faq.conclusion} ${faq.details}`
                }
            }))
        }
    ]
};
---

<Layout
    title={pageTitle}
    description={pageDescription}
    currentPage="about"
    structuredData={pageSchema}
>
    <!-- Hero 头部：明确核心定位、核实时间戳与页内稳定锚点目录 -->
    <section class="section section-hero pb-5">
        <div class="container">
            <div class="has-text-centered mb-5">
                <p class="tag is-primary is-medium mb-3">METHODOLOGY & EEAT STANDARD (2026 EDITION)</p>
                <h1 class="title is-1">
                    客观、可复现、无干扰<br />小火箭评测实验室准则与透明审计白皮书
                </h1>
                <p class="subtitle is-5 mt-3 u-constrained has-text-grey-light">
                    在充斥着虚标倍率、伪造专线与「年付折算价冒充月付」的代理市场中，小火箭实验室（xiaohuojian.homes）坚持以<strong>可验证的 MAI-TEST-BOT 实测截图</strong>、<strong>五地物理延迟基准</strong>与<strong>四级证据链分级披露机制</strong>，为您建立一份具备工程参考价值的网络可观测性数据库。
                </p>
                <div class="tags is-centered mt-3">
                    <span class="tag is-dark">📅 基准图包采样：2026-08-11 / 2026-09-07</span>
                    <span class="tag is-dark">⚡ 五地横评与价格核实：2026-10-19</span>
                    <span class="tag is-dark">🔄 白皮书修订：2026-11-07</span>
                    <span class="tag is-dark">🔬 覆盖样本：42 家机场 (L1–L4 四级分类)</span>
                </div>
            </div>

            <!-- 页内目录导航 (Topic Cluster 稳定锚点) -->
            <nav class="box p-4 mb-2" aria-label="关于实验室页内章节目录" style="background: var(--sp-bg-card); border: 1px solid var(--sp-border); border-radius: 14px;">
                <div class="is-flex is-justify-content-space-between is-align-items-center is-flex-wrap-wrap mb-3">
                    <strong class="is-size-6">🧭 本页专著级目录导航（点击直达对应核查模块）：</strong>
                    <span class="is-size-7 has-text-grey">支持 375px 移动端表格区域滑动与命令一键对照</span>
                </div>
                <div class="buttons are-small mb-0">
                    <a href="#quick-answer" class="button is-primary is-light">1. 六大核心准则直达结论</a>
                    <a href="#benchmark-metrics-table" class="button is-dark">2. 七大评测指标与量化阈值表</a>
                    <a href="#audit-tier-table" class="button is-dark">3. 42家机场四级证据披露表</a>
                    <a href="#methodology-chapters" class="button is-dark">4. 红线、双轨价格与探针方法论</a>
                    <a href="#self-test-playbooks" class="button is-dark">5. 读者本地终端复现手册 (4套实验)</a>
                    <a href="#decision-matrix" class="button is-dark">6. 站内核验与选型决策树</a>
                    <a href="#verified-entries" class="button is-dark">7. 核心验证工具与标杆入口</a>
                    <a href="#faq" class="button is-dark">8. 边界问题 FAQ (8问)</a>
                    <a href="#data-sources-gaps" class="button is-dark">9. 数据来源与待核实缺口披露</a>
                </div>
            </nav>
        </div>
    </section>

    <!-- 模块一：开头直接提供答案 (6大核心准则与核查结论卡片) -->
    <section class="section has-bg-elevated py-6" id="quick-answer" aria-labelledby="quick-answer-heading">
        <div class="container">
            <div class="mb-5">
                <p class="u-label-overline">DIRECT METHODOLOGY ANSWERS</p>
                <h2 id="quick-answer-heading" class="title is-2 mt-1 mb-2">
                    一、30 秒读懂小火箭实验室：我们如何保障评测真实、客观与可复现？
                </h2>
                <p class="has-text-grey-light is-size-6">
                    当您查阅「关于我们 / 评测准则」页面时，最核心的关切无非是：<strong>你们的数据是不是编的？价格有没有猫腻？收了推广佣金还能保持客观吗？我自己在家里怎么验证？</strong> 以下是实验室对这 6 个核心问题的直接结论：
                </p>
            </div>

            <div class="columns is-multiline">
                {methodologyQuickCards.map((card) => (
                    <div class="column is-6-tablet is-4-desktop">
                        <div class="card h-100" style="background: var(--sp-bg-card); border: 1px solid var(--sp-border); border-radius: 14px; display: flex; flex-direction: column; justify-content: space-between;">
                            <div class="card-content">
                                <div class="mb-2">
                                    <span class="tag is-primary is-light has-text-weight-bold">{card.badge}</span>
                                </div>
                                <h3 class="title is-5 mb-3">
                                    <a href={card.anchor} class="hover-text-primary">{card.title}</a>
                                </h3>
                                <p class="is-size-7 mb-3" style="line-height: 1.7;">
                                    {card.coreAnswer}
                                </p>
                                <div class="p-3 has-background-dark mb-3" style="border-radius: 8px;">
                                    <div class="is-size-7 mb-1">
                                        <strong>📊 量化核查依据：</strong>
                                        <span class="has-text-success">{card.verificationMetric}</span>
                                    </div>
                                    <div class="is-size-7">
                                        <strong>⚠️ 适用边界与限制：</strong>
                                        <span>{card.boundaryLimit}</span>
                                    </div>
                                </div>
                                <a href={card.anchor} class="button is-small is-outlined is-fullwidth">
                                    阅读该准则完整工程细则 ↓
                                </a>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 模块二：有依据的核心对比表 (表1：7大评测指标与量化阈值总表；表2：42家机场四级证据分类表) -->
    <section class="section py-6" id="benchmark-metrics-table" aria-labelledby="metrics-table-heading">
        <div class="container">
            <div class="mb-5">
                <p class="u-label-overline">QUANTITATIVE EVALUATION RUBRIC</p>
                <h2 id="metrics-table-heading" class="title is-2 mt-1 mb-2">
                    二、实验室 7 大量化评测指标、测试工具链与评级淘汰阈值总表
                </h2>
                <p class="has-text-grey-light is-size-6 mb-3">
                    为彻底告别「主观感觉快/慢」的模糊评价，小火箭实验室将机场评测拆解为 7 个可量化的工程维度。每一项指标均明确规定了<strong>权重占比、标准测试工具、及格基准线、优秀专线标杆值以及一票否决/降级规则</strong>：
                </p>
                <div class="notification is-dark is-size-7 py-2 px-3 mb-4">
                    💡 <strong>移动端阅读提示：</strong> 在 375px 手机屏幕下，下方两张核心标准表均支持<strong>区域内左右平滑滑动</strong>，保证页面整体零横向溢出。
                </div>
            </div>

            <!-- 核心表 1：7 大评测指标与阈值总表 -->
            <div class="table-container box p-0 mb-6" style="overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 12px; border: 1px solid var(--sp-border);">
                <table class="table is-fullwidth is-striped is-hoverable mb-0" style="min-width: 1120px; font-size: 0.85rem;">
                    <thead>
                        <tr>
                            <th style="min-width: 145px;">评测维度与指标</th>
                            <th style="min-width: 90px;">权重分类</th>
                            <th style="min-width: 190px;">标准测试工具与采样方法</th>
                            <th style="min-width: 155px;">合格基准线 (Pass)</th>
                            <th style="min-width: 175px;">优秀专线标杆值 (L1 级)</th>
                            <th style="min-width: 175px;">降级或预警淘汰规则</th>
                            <th style="min-width: 170px;">站内真实核实样本举例</th>
                        </tr>
                    </thead>
                    <tbody>
                        {benchmarkMetricRows.map((row) => (
                            <tr>
                                <td class="has-text-weight-bold">{row.metricName}</td>
                                <td>
                                    <span class="tag is-primary is-light is-small">{row.weight}</span>
                                    <div class="is-size-7 has-text-grey mt-1">{row.category.split(" ")[0]}</div>
                                </td>
                                <td>{row.testToolAndMethod}</td>
                                <td>{row.passThreshold}</td>
                                <td class="has-text-success has-text-weight-semibold">{row.excellentBenchmark}</td>
                                <td class="has-text-danger is-size-7">{row.failOrDowngradeRule}</td>
                                <td class="is-size-7">
                                    <div>{row.evidenceExample}</div>
                                    <span class="has-text-grey">核实日: {row.verifiedDate}</span>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>

            <!-- 分项对比表 2：42 家收录机场的 L1–L4 四级证据链分类与披露边界表 -->
            <div id="audit-tier-table" class="pt-4">
                <h3 class="title is-3 mb-2">
                    📂 分项标准表：全站 42 家收录机场的 L1–L4 四级证据完整度分类制度
                </h3>
                <p class="has-text-grey-light is-size-6 mb-4">
                    为什么本站有的机场有五地毫秒级延迟表和多张高清测速图，而有的机场标注为「待核实」？因为我们严格依据<strong>手头掌握的真实证据完整度</strong>将 42 家机场划分为 L1 至 L4 四个等级，严禁把未实测的品牌包装成「实测推荐」：
                </p>

                <div class="table-container box p-0" style="overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 12px; border: 1px solid var(--sp-border);">
                    <table class="table is-fullwidth is-striped is-hoverable mb-0" style="min-width: 1060px; font-size: 0.85rem;">
                        <thead>
                            <tr>
                                <th style="min-width: 135px;">证据等级代号</th>
                                <th style="min-width: 80px;">收录数量</th>
                                <th style="min-width: 230px;">包含品牌清单 (对应排名)</th>
                                <th style="min-width: 210px;">必备证据链标准</th>
                                <th style="min-width: 180px;">允许的推荐与表述范围</th>
                                <th style="min-width: 180px;">严厉禁止的误导行为</th>
                            </tr>
                        </thead>
                        <tbody>
                            {auditTierRows.map((tier) => (
                                <tr>
                                    <td>
                                        <strong class="has-text-primary">{tier.tierCode}</strong>
                                        <div class="is-size-7 has-text-grey mt-1">{tier.tierName}</div>
                                    </td>
                                    <td>
                                        <span class="tag is-dark has-text-weight-bold">{tier.brandCount}</span>
                                    </td>
                                    <td class="is-size-7">{tier.representativeBrands}</td>
                                    <td>{tier.evidenceStandard}</td>
                                    <td class="has-text-success is-size-7">{tier.allowedClaims}</td>
                                    <td class="has-text-danger is-size-7">{tier.prohibitedClaims}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <!-- 模块三：围绕用户问题展开 H2 与 H3 (四大核心方法论与治理章节 + 真实图包存证展示) -->
    <section class="section has-bg-elevated py-6" id="methodology-chapters" aria-labelledby="chapters-heading">
        <div class="container">
            <div class="mb-5">
                <p class="u-label-overline">DEEP-DIVE GOVERNANCE & METHODOLOGY</p>
                <h2 id="chapters-heading" class="title is-2 mt-1 mb-2">
                    三、深度拆解：评测红线、双轨价格审计、探针工具链与商业伦理防火墙
                </h2>
                <p class="has-text-grey-light is-size-6">
                    以下四个章节严格围绕<strong>「是什么问题与何时需要关注 → 实验室如何具体判断与操作 → 存在哪些客观条件与限制 → 真实审计案例与下一步行动」</strong>展开：
                </p>
            </div>

            {methodologyChapters.map((ch) => (
                <article class="box p-5 mb-6" id={ch.id} style="background: var(--sp-bg-card); border: 1px solid var(--sp-border); border-radius: 16px;">
                    <div class="is-flex is-justify-content-space-between is-align-items-center is-flex-wrap-wrap mb-3">
                        <div class="tags mb-0">
                            <span class="tag is-primary has-text-weight-bold">{ch.number}</span>
                            <span class="tag is-dark">{ch.tag}</span>
                        </div>
                        <span class="is-size-7 has-text-grey">最后复核：2026-10-19 / 2026-11-07</span>
                    </div>

                    <h3 class="title is-3 mb-3">{ch.title}</h3>

                    <div class="notification is-dark p-4 mb-4" style="border-left: 4px solid var(--sp-primary);">
                        <p class="is-size-6 mb-0" style="line-height: 1.75;">
                            {ch.whatAndWhen}
                        </p>
                    </div>

                    <div class="columns is-multiline mb-4">
                        <div class="column is-7">
                            <div class="p-4 has-background-dark h-100" style="border-radius: 12px; border: 1px solid var(--sp-border);">
                                <h4 class="title is-5 mb-3">🛠️ 实验室如何具体判断与执行操作？</h4>
                                <ul class="is-size-6" style="line-height: 1.8; list-style: none; padding-left: 0;">
                                    {ch.howToOperate.map((step) => (
                                        <li class="mb-3 pb-2" style="border-bottom: 1px dashed var(--sp-border);">
                                            {step}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>

                        <div class="column is-5">
                            <div class="p-4 has-background-dark h-100" style="border-radius: 12px; border: 1px solid var(--sp-border);">
                                <h4 class="title is-5 mb-3">⚠️ 客观条件、适用边界与限制说明</h4>
                                <ul class="is-size-6 mb-4" style="line-height: 1.75; padding-left: 1.1rem;">
                                    {ch.conditionsAndLimits.map((lim) => (
                                        <li class="mb-2">{lim}</li>
                                    ))}
                                </ul>

                                <div class="p-3" style="background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid var(--sp-border);">
                                    <h5 class="title is-6 mb-2">📌 {ch.realCaseEvidence.title}</h5>
                                    <p class="is-size-7 mb-3" style="line-height: 1.7;">
                                        {ch.realCaseEvidence.detail}
                                    </p>
                                    <div class="buttons are-small mb-0">
                                        {ch.realCaseEvidence.relatedLinks.map((lnk) => (
                                            <a href={lnk.url} class="button is-primary is-light">
                                                {lnk.label}
                                            </a>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {ch.id === "chapter-hardware-toolchain" && (
                        <div class="p-4 has-background-dark mb-4" style="border-radius: 12px; border: 1px solid var(--sp-border);">
                            <h4 class="title is-5 mb-3">🖼️ 实验室 MAI-TEST-BOT 原始测试图包样本示例（点击可放大核验细节）</h4>
                            <div class="columns is-variable is-4">
                                <div class="column is-6">
                                    <figure class="image">
                                        <img
                                            src="/images/reviews/guangsu-speedtest-2026.png"
                                            alt="光速云 2026-08-11 MAI-TEST-BOT 节点延迟、吞吐峰值与流媒体解锁实测样本图"
                                            loading="lazy"
                                            width="900"
                                            height="520"
                                            style="border-radius: 8px; border: 1px solid var(--sp-border);"
                                        />
                                        <figcaption class="is-size-7 has-text-grey mt-2">
                                            ▲ 样本 A：光速云 (LightSpeed) 实测拓扑图（2026-08-11 采样 + 2026-10-19 五地复核：香港 22ms / 536Mbps）。完整图集见 <a href="/reviews">/reviews 真实测评图库</a>。
                                        </figcaption>
                                    </figure>
                                </div>
                                <div class="column is-6">
                                    <figure class="image">
                                        <img
                                            src="/images/reviews/muguang-speedtest-2026.png"
                                            alt="暮光加速 2026-08-11 MAI-TEST-BOT IEPL专线测速与全区流媒体解锁实测样本图"
                                            loading="lazy"
                                            width="900"
                                            height="520"
                                            style="border-radius: 8px; border: 1px solid var(--sp-border);"
                                        />
                                        <figcaption class="is-size-7 has-text-grey mt-2">
                                            ▲ 样本 B：暮光加速 (Twilight) 实测拓扑图（2026-08-11 采样 + 2026-10-19 五地复核：香港 22ms / 521Mbps）。详情见 <a href="/airports/muguang">/airports/muguang</a>。
                                        </figcaption>
                                    </figure>
                                </div>
                            </div>
                        </div>
                    )}

                    <div class="p-3 has-background-dark is-size-6" style="border-radius: 8px;">
                        <strong>👉 下一步操作建议：</strong> {ch.nextAction}
                    </div>
                </article>
            ))}
        </div>
    </section>

    <!-- 模块四：与本页有关的技术原理与读者本地复现操作手册 (4套可一键对照实验) -->
    <section class="section py-6" id="self-test-playbooks" aria-labelledby="playbooks-heading">
        <div class="container">
            <div class="mb-5">
                <p class="u-label-overline">REPRODUCIBLE VERIFICATION PLAYBOOK</p>
                <h2 id="playbooks-heading" class="title is-2 mt-1 mb-2">
                    四、不盲信任何榜单：读者本地 3 分钟复现与节点验真操作手册
                </h2>
                <p class="has-text-grey-light is-size-6">
                    真正科学的评测应当是<strong>可复现（Reproducible）</strong>的。当您按照本站建议先花 ¥15–¥25 购买了一个月的测试套餐后，无需安装复杂的抓包软件，只需在自己的电脑或手机上执行以下 4 个标准实验，即可在 3 分钟内独立验证该机场是否虚标：
                </p>
            </div>

            <div class="columns is-multiline">
                {selfTestPlaybooks.map((pb) => (
                    <div class="column is-6-desktop is-12-tablet mb-4" id={pb.id}>
                        <div class="box p-5 h-100" style="background: var(--sp-bg-card); border: 1px solid var(--sp-border); border-radius: 14px; display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <div class="tags mb-2">
                                    <span class="tag is-info is-light has-text-weight-bold">本地验真实验</span>
                                    <span class="tag is-dark">{pb.toolName}</span>
                                </div>
                                <h3 class="title is-4 mb-2">{pb.title}</h3>
                                <p class="is-size-7 has-text-grey-light mb-3">
                                    <strong>🎯 适用排障场景：</strong>{pb.scenario}
                                </p>

                                <div class="mb-3">
                                    <strong class="is-size-7">📋 标准执行步骤：</strong>
                                    <ul class="is-size-7 mt-1 pl-4" style="line-height: 1.7;">
                                        {pb.steps.map((s) => <li class="mb-1">{s}</li>)}
                                    </ul>
                                </div>

                                <pre class="p-3 mb-3 is-size-7" style="background: #111622; color: #e2e8f0; border-radius: 8px; overflow-x: auto; white-space: pre-wrap; word-break: break-all;"><code>{pb.commandOrConfig}</code></pre>
                            </div>

                            <div class="p-3 has-background-dark is-size-7" style="border-radius: 8px;">
                                <div class="mb-1">
                                    <strong class="has-text-success">✅ 合格输出基准：</strong>{pb.expectedOutput}
                                </div>
                                <div>
                                    <strong class="has-text-warning">🔧 异常诊断与修复：</strong>{pb.troubleshootingTip}
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>

            <div class="notification is-dark mt-2 is-size-6">
                💡 <strong>需要更完整的 Clash Verge Rev / Shadowrocket 配置文件模板？</strong> 请前往 <a href="/guides#client-routing-verification" class="has-text-primary has-text-weight-bold">《场景化专线选型指南 · 第六节客户端分流配置》</a> 或 <a href="/clients" class="has-text-primary has-text-weight-bold">《全平台客户端配置中心 (/clients)》</a> 获取完整 YAML 规则段。
            </div>
        </div>
    </section>

    <!-- 模块五：决策与操作路径 (5个明确分支引导读者使用全站资源) -->
    <section class="section has-bg-elevated py-6" id="decision-matrix" aria-labelledby="decision-heading">
        <div class="container">
            <div class="mb-5">
                <p class="u-label-overline">READER DECISION & VERIFICATION PATHS</p>
                <h2 id="decision-heading" class="title is-2 mt-1 mb-2">
                    五、读者行动决策路径：了解实验室准则后，下一步该看哪个专题？
                </h2>
                <p class="has-text-grey-light is-size-6">
                    根据您当前所处的选型阶段（核验真实性、按场景比价、查全量名单、配客户端或提交勘误），请直接按以下 5 条分支进入对应模块：
                </p>
            </div>

            <div class="columns is-multiline">
                {aboutDecisionBranches.map((br) => (
                    <div class="column is-6-tablet is-4-desktop" id={br.id}>
                        <div class="box p-4 h-100" style="background: var(--sp-bg-card); border: 1px solid var(--sp-border); border-radius: 14px; display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <h3 class="title is-5 mb-2">{br.userNeed}</h3>
                                <p class="is-size-7 has-text-grey mb-3">
                                    <strong>🔍 首要核查重点：</strong>{br.whatToVerifyFirst}
                                </p>
                                <div class="p-3 has-background-dark mb-3 is-size-7" style="border-radius: 8px;">
                                    <strong>✅ 操作核对清单：</strong>
                                    <ul class="mt-1 pl-4" style="line-height: 1.65;">
                                        {br.actionChecklist.map((item) => <li class="mb-1">{item}</li>)}
                                    </ul>
                                </div>
                            </div>
                            <a href={br.recommendedEntryUrl} class="button is-primary is-small is-fullwidth has-text-weight-bold">
                                {br.recommendedEntryName}
                            </a>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 模块六：真实且相关的转化与核心工具卡片 (写清名称、适用人群、费用/条件、限制、核实时间与有效入口) -->
    <section class="section py-6" id="verified-entries" aria-labelledby="entries-heading">
        <div class="container">
            <div class="mb-5">
                <p class="u-label-overline">VERIFIED HUB & BENCHMARK ENTRIES</p>
                <h2 id="entries-heading" class="title is-2 mt-1 mb-2">
                    六、实验室核心数据库与 L1 实测标杆直达卡片
                </h2>
                <p class="has-text-grey-light is-size-6">
                    以下卡片汇总了本站最核心的三大工程数据专题以及综合排名第 1 的 L1 双批次实测标杆档案，每张卡片均明确标注<strong>适用人群、费用或查阅条件、主要限制与最后核实日期</strong>：
                </p>
            </div>

            <div class="columns is-multiline">
                {aboutConversionCards.map((card) => (
                    <div class="column is-6-tablet is-3-desktop" id={card.id}>
                        <div class="box p-4 h-100" style="background: var(--sp-bg-card); border: 1px solid var(--sp-border); border-radius: 14px; display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <span class="tag is-warning is-light is-small mb-2">{card.badge}</span>
                                <h3 class="title is-5 mb-2">{card.name}</h3>
                                <ul class="is-size-7 mb-4" style="line-height: 1.7; list-style: none; padding-left: 0;">
                                    <li class="mb-2"><strong>👥 适用人群：</strong>{card.targetAudience}</li>
                                    <li class="mb-2"><strong>💳 费用/领取条件：</strong><span class="has-text-success">{card.costOrCondition}</span></li>
                                    <li class="mb-2"><strong>⚠️ 主要限制：</strong><span class="has-text-danger">{card.mainLimitation}</span></li>
                                    <li><strong>📅 最后核实时间：</strong>{card.verifiedDate}</li>
                                </ul>
                            </div>
                            <a href={card.targetUrl} class="button is-primary is-outlined is-fullwidth is-small has-text-weight-bold">
                                {card.buttonText}
                            </a>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 模块七：FAQ 与边界问题 (8个高价值问答) -->
    <section class="section has-bg-elevated py-6" id="faq" aria-labelledby="faq-heading">
        <div class="container">
            <div class="mb-5">
                <p class="u-label-overline">METHODOLOGY & BOUNDARY FAQ</p>
                <h2 id="faq-heading" class="title is-2 mt-1 mb-2">
                    七、常见问题与评测边界答疑 (FAQ)
                </h2>
                <p class="has-text-grey-light is-size-6">
                    针对读者最常询问的「测速差距原因」「两个核实日期含义」「待核实标签逻辑」「推广链接价格与售后责任边界」等 8 个核心问题，我们先给出明确结论，再附带工程解释：
                </p>
            </div>

            <div class="columns is-multiline">
                {aboutFaqs.map((faq) => (
                    <div class="column is-6-desktop is-12-tablet mb-3">
                        <div class="box p-4 h-100" style="background: var(--sp-bg-card); border: 1px solid var(--sp-border); border-radius: 12px;">
                            <h3 class="title is-5 mb-2">{faq.question}</h3>
                            <p class="is-size-6 has-text-weight-semibold has-text-primary mb-2">
                                {faq.conclusion}
                            </p>
                            <p class="is-size-7 has-text-grey-light mb-2" style="line-height: 1.75;">
                                {faq.details}
                            </p>
                            {faq.relatedAnchor && (
                                <a href={faq.relatedAnchor} class="is-size-7 has-text-primary">
                                    🔗 查看对应正文准则章节 ↑
                                </a>
                            )}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 模块八：数据来源、维护者说明与具体资料缺口披露 -->
    <section class="section py-6" id="data-sources-gaps" aria-labelledby="gaps-heading">
        <div class="container">
            <div class="box p-5" style="background: var(--sp-bg-card); border: 1px solid var(--sp-border); border-radius: 16px;">
                <p class="u-label-overline">DATA SOURCES, AUTHORSHIP & GAPS DISCLOSURE</p>
                <h2 id="gaps-heading" class="title is-3 mt-1 mb-3">
                    八、数据来源、维护团队声明与当前待核实资料缺口清单
                </h2>
                <div class="columns is-multiline is-size-7" style="line-height: 1.8;">
                    <div class="column is-6">
                        <div class="p-4 has-background-dark h-100" style="border-radius: 10px;">
                            <h3 class="title is-5 mb-2">📚 一手数据来源与维护责任声明</h3>
                            <ul class="pl-4">
                                <li><strong>维护机构：</strong>小火箭网络基础设施评测智库（<code>xiaohuojian.homes</code> 独立评测工程组）。</li>
                                <li><strong>测速图包批次：</strong><code>public/images/reviews/</code> 下归档的 25 张高清测速图与流媒体解锁矩阵图，分别采样于 <code>2026-08-11</code> 与 <code>2026-09-07</code>。</li>
                                <li><strong>五地延迟与套餐复核批次：</strong><code>2026-10-19</code> 对 42 家品牌的月付实价、年付折算、永久包、优惠码、客户端导入模式及 12 家主力专线五地（港/新/日/台/美）RTT 与吞吐进行统一复核。</li>
                                <li><strong>本页修订日期：</strong><code>2026-11-07</code>（重构 E-E-A-T 量化评测标准、四级证据分类与本地终端验真手册）。</li>
                            </ul>
                        </div>
                    </div>

                    <div class="column is-6">
                        <div class="p-4 has-background-dark h-100" style="border-radius: 10px;">
                            <h3 class="title is-5 mb-2">🔍 当前已知资料缺口与待核实项（绝不伪造补齐）</h3>
                            <ul class="pl-4">
                                <li><strong>宇宙云 (#11 yuzhou)：</strong><code>2026-10-19</code> 巡检确认其节点失联无法复测、官网打开异常，全站已标记高风险预警并建议暂缓购买。</li>
                                <li><strong>可信云 (#18 kexin)：</strong>原始资料注明与暮光加速同源，缺失 <code>2026-10-19</code> 独立五地测速图，列为「待核实」。</li>
                                <li><strong>5.6 元年付折算同质化组（大佬云 #5 / 闪电鼠 #22 / 云界线 #23 / 榴莲云 #24 / 环球梯 #26）：</strong>仅具品牌方提供的 <code>¥5.6/月 (60GB)</code> 年付折算价与基础协议说明，缺失独立实验室测速图与完整高阶套餐表。</li>
                                <li><strong>第 29–42 名历史收录品牌（WgetCloud、白月光、龙猫云、肥猫云、TNTCloud 等 14 家）：</strong>仅保留品牌名与历史定位摘要，缺失 <code>2026-10-19</code> 统一批次价格表与实测截图，归入 L4 历史档案级。</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
